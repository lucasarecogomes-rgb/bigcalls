{
  "manifest_version": 3,
  "name": "BIGCALLS J7 Bridge",
  "version": "0.1.0",
  "description": "Captura sinais do J7Tracker no navegador e envia eventos estruturados ao backend local do BIGCALLS.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8790/*",
    "http://localhost:8790/*",
    "http://127.0.0.1:8791/*",
    "http://localhost:8791/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://j7tracker.io/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BIGCALLS J7 Bridge"
  }
}
