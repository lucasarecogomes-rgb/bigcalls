APP_BIND_ADDR=127.0.0.1:8790
RUST_LOG=info

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

ANALYSIS_HISTORY_PATH=data/analysis-history.jsonl
SOCIAL_HISTORY_PATH=data/social-history.jsonl

# Coleta opcional de novos tokens Pump.fun, sem chave de API ou chamada LLM.
PUMPFUN_DISCOVERY_ENABLED=false

# Apenas gates de lixo/rug obvio. A decisao final nao deve virar um score fixo.
MIN_LIQUIDITY_USD=5000
MAX_TOP10_HOLDERS_PCT=80
MAX_CREATOR_HOLDER_PCT=35
MAX_SNIPER_PCT=50
